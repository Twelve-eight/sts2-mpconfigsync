<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SyncProbeV2</AssemblyName>
    <RootNamespace>SyncProbeV2</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- NO GodotSharp runtime use: GodotSharp is referenced only because
         PacketWriter/Mathf (pure managed math) sit in the engine's shared
         types. If these sources compile AND run without touching a Godot
         native static, the no-Godot claim holds. -->
    <Reference Include="sts2"><HintPath>G:/steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>G:/steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64/GodotSharp.dll</HintPath></Reference>
    <Reference Include="BaseLib"><HintPath>G:/steam/steamapps/workshop/content/2868840/3737335127/BaseLib/BaseLib.dll</HintPath></Reference>
  </ItemGroup>
  <!-- Exact-source fixture: the receiver sources are COMPILED INTO this probe
       (not referenced from the mod dll) with only the logger swapped for a
       shim, so every assertion below executes the real production code. -->
  <ItemGroup>
    <Compile Include="Src/ConfigSyncApplier.cs" />
    <Compile Include="Src/ConfigSyncMessage.cs" />
    <Compile Include="Src/MpNetSession.cs" />
    <Compile Include="Src/ConfigPropertyScanner.cs" />
    <Compile Include="Src/MpConfigSyncConfig.cs" />
  </ItemGroup>
</Project>
